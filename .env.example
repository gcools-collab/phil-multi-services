# Recommandé hors Vercel. Sur Vercel, l’URL système du projet est utilisée automatiquement.
# Utiliser l’origine publique HTTPS sans slash final.
NEXT_PUBLIC_SITE_URL=https://votre-domaine.fr

# Clé serveur Places API (New), à configurer dans Vercel.
# Ne jamais préfixer cette variable avec NEXT_PUBLIC_.
GOOGLE_PLACES_API_KEY=

# Identifiant Google du lieu Phil Multi-Services.
GOOGLE_PLACE_ID=

# Clé serveur d’envoi du formulaire de réparation.
# Vérifier philmultiservices59.fr chez Resend avant la mise en production.
RESEND_API_KEY=
